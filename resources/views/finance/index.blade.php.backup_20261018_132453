<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Finance Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f3f5f9; color: #172033; }
        header { background: #172554; color: white; padding: 18px 22px; }
        main { max-width: 1000px; margin: 28px auto; padding: 0 16px; }
        .card { background: white; padding: 24px; border-radius: 12px; box-shadow: 0 3px 12px #0000000d; }
        a { color: #1d4ed8; }
        .button { display: inline-block; padding: 10px 15px; border-radius: 7px; background: #1d4ed8; color: white; text-decoration: none; }
    </style>
</head>
<body>
    <header>
        <strong>Finance Module</strong>
    </header>

    <main>
        <h1>Finance Dashboard</h1>

        <div class="card">
            <h2>Access verified</h2>
            <p>Your account has the <code>finance.view</code> permission.</p>
            <p>Financial balances and transactions will appear here after the finance ledger and accounting rules are implemented.</p>

            <a class="button" href="{{ route('employee.finance.manage') }}">
                Finance Management
            </a>

            <p><a href="{{ route('employee.home') }}">Back to Employee Dashboard</a></p>
        </div>
    </main>
</body>
</html>